DATABASE_URL=postgresql://postgres:password@db:5432/marae_db
PAYLOAD_SECRET=notsetyet

# JWT_SECRET=some-long-random-string

# Email — defaults below point at the Mailpit dev container (see
# docker-compose.yml), so mail "sent" locally shows up at
# http://localhost:8025 instead of going anywhere real. Override these to
# point at a real provider (Gmail SMTP, Resend, Mailgun, SES, etc.) in
# production.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=Marae System <no-reply@marae.local>
