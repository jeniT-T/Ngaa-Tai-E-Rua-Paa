# Copy this file to ".env" in the project root (next to README.md) and fill it in.
# The backend reads it from there. Never commit the real .env file.

# PostgreSQL connection string. Create the database first (see README, step 2).
# Change "password" to the password you chose when installing PostgreSQL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/marae_db

# A long random string used to sign login cookies. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a different value on every installation.
JWT_SECRET=change-me-to-a-long-random-string

# Email (optional while developing). If SMTP_HOST is left out, emails such as
# password-reset links are printed in the backend terminal instead of being sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=Manage My Marae <no-reply@example.com>

# Production only: the public address of the website, for example
# https://your-site.example.com (needed for browser requests to be allowed).
# FRONTEND_URL=
# NODE_ENV=production
